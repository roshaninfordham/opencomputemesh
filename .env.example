# OpenComputeMesh coordinator settings. Every Settings field in ocm/config.py is read from OCM_<FIELD>.
# The coordinator does not load this file itself: `set -a; source .env; set +a` before `uv run ocm serve`.
# Values below are the defaults.

# "development" or anything else; non-development requires OCM_ADMIN_TOKEN (if set) to be >= 32 chars.
OCM_ENV=development
# Bind address and port. Keep 127.0.0.1 when publishing through a local tunnel.
OCM_HOST=127.0.0.1
OCM_PORT=8000
# SQLite file path (a filesystem path, not a URL).
OCM_DATABASE_PATH=./data/opencomputemesh.db
# Directory for the generated join code file (join_code).
OCM_DATA_DIR=./data
# Bearer token for /api/v1/admin/*. Empty disables admin routes. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
OCM_ADMIN_TOKEN=
# Fixed join code. Empty: generated once and stored in $OCM_DATA_DIR/join_code.
OCM_JOIN_CODE=
# Display name of the network.
OCM_NETWORK_NAME="OpenComputeMesh Demo"
# Grant OCM_DEMO_GRANT_OCC credits to each new member.
OCM_DEMO_MODE=true
OCM_DEMO_GRANT_OCC=100
# Nodes without a heartbeat for this long are ineligible and swept offline.
OCM_NODE_HEARTBEAT_TTL_SECONDS=60
# Used by ocm-agent as its default --heartbeat; the coordinator does not read it.
OCM_NODE_HEARTBEAT_INTERVAL_SECONDS=20
# Delay before a disconnected node is shown OFFLINE.
OCM_NODE_OFFLINE_GRACE_SECONDS=10
# Lifetime of one-time enrollment tokens.
OCM_ENROLLMENT_TOKEN_TTL_SECONDS=600
# Maximum total characters across a request's messages.
OCM_MAX_PROMPT_CHARS=12000
# max_tokens used when a request does not set one, and the upper bound for max_tokens.
OCM_DEFAULT_MAX_OUTPUT_TOKENS=512
OCM_MAX_OUTPUT_TOKENS=2048
# Deadline from dispatch to completion.
OCM_JOB_TIMEOUT_SECONDS=180
# How long a job waits for a free eligible worker.
OCM_QUEUE_TIMEOUT_SECONDS=30
# Network-wide queued job limit.
OCM_MAX_QUEUED_JOBS=32
# Concurrent jobs per requesting member.
OCM_MAX_ACTIVE_JOBS_PER_MEMBER=2
# Upper bound on a node's advertised --max-jobs.
OCM_MAX_CONCURRENT_JOBS_PER_NODE=1
# Demo tariff in whole OCC per 1k tokens. Demo policy, not market prices.
OCM_DEFAULT_INPUT_OCC_PER_1K=1
OCM_DEFAULT_OUTPUT_OCC_PER_1K=3
# Minimum charge per settled job, in micro-OCC.
OCM_MIN_JOB_CHARGE_MICRO_OCC=0
# Extra allowed browser origins (comma-separated) besides the request's own host.
OCM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built web app served by the coordinator.
OCM_WEB_DIST=./web/dist
